# Store every text file with LF in the repository, whatever the OS or editor.
* text=auto eol=lf

# Vendored Pine references are text and must be normalized like any other source.
*.pine text eol=lf

# CSV is text data, not binary.
*.csv text eol=lf

# Images.
*.bmp binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.tif binary
*.tiff binary
*.webp binary

# Compressed and archived data.
*.7z binary
*.bz2 binary
*.gz binary
*.rar binary
*.tar binary
*.tgz binary
*.xz binary
*.zip binary

# Numeric arrays and serialized data.
*.feather binary
*.h5 binary
*.hdf5 binary
*.npy binary
*.npz binary
*.parquet binary
*.pickle binary
*.pkl binary

# Compiled and database artifacts.
*.dll binary
*.exe binary
*.pyc binary
*.pyo binary
*.so binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Documents and media.
*.doc binary
*.docx binary
*.mp3 binary
*.mp4 binary
*.pdf binary
*.wav binary
*.xls binary
*.xlsx binary
