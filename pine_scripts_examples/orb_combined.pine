//@version=6
strategy("ORB Combined [NY]", overlay=true,
         pyramiding=0,
         process_orders_on_close=true,
         default_qty_type=strategy.fixed,
         default_qty_value=1,
         initial_capital=10000,
         currency=currency.USD,
         margin_long=5,
         margin_short=5,
         max_lines_count=500,
         max_labels_count=500,
         max_boxes_count=500)

// ─────────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────────
var string G1 = "⏱  ORB Period  ·  All times: America / New_York"
var string G2 = "📐  Lines"
var string G3 = "🏷  Labels"
var string G4 = "🟦  Zone"
var string G5 = "📊  FVG"
var string G6 = "💰  Position"

// ── ORB period ────────────────────────────────────────────────────────────────
i_orbPeriod = input.string(
     "5-min  (9:30 – 9:35)",
     "ORB Period",
     options  = ["5-min  (9:30 – 9:35)", "15-min  (9:30 – 9:45)"],
     tooltip  = "Captures the exact High / Low of the first candle of the NY session.\n• 5-min  → single 9:30–9:35 AM candle\n• 15-min → single 9:30–9:45 AM candle\nAll times are New York (America/New_York).",
     group    = G1)

// ── Lines ─────────────────────────────────────────────────────────────────────
i_highColor = input.color(color.new(#26a69a, 0), "High Line Color", group=G2)
i_lowColor  = input.color(color.new(#ef5350, 0), "Low Line Color",  group=G2)
i_lWidth    = input.int  (2, "Line Width", minval=1, maxval=4,       group=G2)
i_lStyle    = input.string("Solid", "Line Style",
     options = ["Solid","Dashed","Dotted"],                           group=G2)

// ── Labels ────────────────────────────────────────────────────────────────────
i_showLbl   = input.bool  (true,   "Show Labels",                    group=G3)
i_lblHText  = input.string("ORBH", "High Label Text",                group=G3)
i_lblLText  = input.string("ORBL", "Low Label Text",                 group=G3)
i_lblHPos   = input.string("Right","High Label H-Position",
     options = ["Left","Center","Right"],                             group=G3)
i_lblLPos   = input.string("Right","Low Label H-Position",
     options = ["Left","Center","Right"],                             group=G3)
i_lblVAlign = input.string("Middle","Label Vertical Alignment",
     options = ["Top","Middle","Bottom"],                             group=G3)
i_lblSize   = input.string("Small", "Label Size",
     options = ["Tiny","Small","Normal","Large"],                     group=G3)

// ── Zone ──────────────────────────────────────────────────────────────────────
i_showZone  = input.bool(true, "Show ORB Zone",                      group=G4)
i_zoneAlpha = input.int (90,   "Zone Transparency",
     minval=50, maxval=99,                                            group=G4)

// ── FVG ───────────────────────────────────────────────────────────────────────
i_fvgBoxLen   = input.int  (22, "Box Length", minval=1,              group=G5)
i_fvgBullCol  = input.color(color.new(color.green, 90),
                            "Bull Color",                            group=G5)
i_fvgBearCol  = input.color(color.new(color.red, 90),
                            "Bear Color",                            group=G5)
i_fvgSession  = input.session("0930-1200", "FVG Session (NY)",
     tooltip = "New York session when FVG detection is active.\nFVGs are tracked from session start until the ORB breaks.\nAll remaining FVGs are deleted when the session ends.",
                                                                     group=G5)
i_maxFvgs     = input.int  (100, "Max Tracked FVGs",
     minval=1, maxval=500,
     tooltip = "Maximum number of simultaneous FVG boxes on chart.\nWhen the limit is reached, the oldest FVG is removed.",
                                                                     group=G5)

// ── Position ──────────────────────────────────────────────────────────────────
i_accountSize = input.float(10000, "Account Size ($)",
     minval=1000, step=1000,
     tooltip = "Starting account size for fixed-fractional position sizing.",
     group   = G6)

i_riskPercent = input.float(1.0, "Risk per Trade (%)",
     minval=0.1, maxval=100, step=0.1,
     tooltip = "% of account size risked per trade.\nDetermines position size based on SL distance (FVG Ext Cover).",
     group   = G6) / 100


// ─────────────────────────────────────────────────────────────────────────────
//  DERIVED CONSTANTS
// ─────────────────────────────────────────────────────────────────────────────
NY = "America/New_York"

orbEndMin = i_orbPeriod == "5-min  (9:30 – 9:35)"  ? 35  : 45


// ─────────────────────────────────────────────────────────────────────────────
//  HELPER FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────
f_ls() =>
    i_lStyle == "Dashed" ? line.style_dashed  :
     i_lStyle == "Dotted" ? line.style_dotted : line.style_solid

f_sz() =>
    i_lblSize == "Tiny"   ? size.tiny   :
     i_lblSize == "Normal" ? size.normal :
     i_lblSize == "Large"  ? size.large  : size.small

f_vStyle() =>
    switch i_lblVAlign
        "Top"    => label.style_label_down
        "Bottom" => label.style_label_up
        =>          label.style_label_center

i_extEnabled = input.bool(true, "FVG Ext Enabled", group=G5)
i_extLen     = input.int(22, "FVG Ext Length", minval=1, group=G5)
i_extWidth   = input.int(1, "FVG Ext Width", minval=1, maxval=4, group=G5)
i_extStyle   = input.string("Solid", "FVG Ext Style", options=["Solid","Dashed","Dotted"], group=G5)

f_extStyle() =>
    i_extStyle == "Dashed" ? line.style_dashed  :
     i_extStyle == "Dotted" ? line.style_dotted : line.style_solid

f_lx(pos, s, e) =>
    switch pos
        "Left"   => s
        "Center" => math.round((s + e) / 2)
        =>          e


// ─────────────────────────────────────────────────────────────────────────────
//  CURRENT-BAR TIME  (1-minute chart required)
// ─────────────────────────────────────────────────────────────────────────────
nyH = hour      (time, NY)
nyM = minute    (time, NY)
nyD = dayofmonth(time, NY)

// ORB windows
inORBWindow = nyH == 9 and nyM >= 30 and nyM < orbEndMin
pastORB     = (nyH == 9 and nyM >= orbEndMin) or nyH > 9

// Trade session — explicit NY hour/minute check avoids session-parsing pitfalls on futures
// Eligible: 9:30 AM through 11:59 AM New York time
inTradeSession = (nyH == 9 and nyM >= 30) or (nyH >= 10 and nyH <= 11)

// FVG window — uses input.session() for FVG detection time range
inFVGWindow = not na(time(timeframe.period, i_fvgSession, NY))

// ── Timeframe guard ────────────────────────────────────────────────────────
if timeframe.period != "1"
    runtime.error("ORB Combined [NY] requires a 1-minute chart.\nCurrent timeframe: " + timeframe.period)


// ─────────────────────────────────────────────────────────────────────────────
//  PERSISTENT STATE
// ─────────────────────────────────────────────────────────────────────────────
// --- ORB state ---
var float    orbH            = na
var float    orbL            = na
var bool     drawn           = false
var bool     stopped         = false
var int      startBar        = na
var int      sessionStartBar = na
var line     lnH             = na
var line     lnL             = na
var label    lbH             = na
var label    lbL             = na
var linefill zFill           = na

// --- FVG state ---
var array<box>   fvgBoxes      = array.new<box>()
var array<label> fvgLabels     = array.new<label>()
var array<float> fvgTops       = array.new<float>()
var array<float> fvgBots       = array.new<float>()
var array<bool>  fvgIsBulls    = array.new<bool>()
var array<line>  fvgExtLines   = array.new<line>()
var bool         fvgWasActive  = false

// --- Pending FVG (drawn on bar open, confirmed/deleted on bar close) ---
var box   pendingBox   = na
var label pendingLabel = na
var line  pendingExt   = na
var float pendingTop   = na
var float pendingBot   = na

// --- Breakout tracking ---
var float candleCover = na
var float candleEntry = na
var int   orbBreakDir = 0        // 0=unbroken, 1=broke high, -1=broke low

// --- FVG snapshot (captured at ORB break for trade qualification) ---
var float snFvgExt    = na
var bool  snFvgHasExt = false
var bool  snFvgIsBull = false

// --- Trade levels (computed at breakout when qualifying FVG has ext) ---
var float fvgExtCover = na      // SL for Combined strategy (ext-based cover)
var float fvgExtTP    = na      // TP for Combined strategy (ext-based 2:1)


// ─────────────────────────────────────────────────────────────────────────────
//  RESET  ─  new trading day (robust for futures / weekends)
// ─────────────────────────────────────────────────────────────────────────────
if na(nyD[1]) or nyD != nyD[1]

    // Close any open position from previous day
    strategy.close_all(comment="EOD")

    // --- Delete old ORB drawings ---
    if not na(lnH)
        line.delete(lnH)
        line.delete(lnL)
    if not na(lbH)
        label.delete(lbH)
        label.delete(lbL)
    if not na(zFill)
        linefill.delete(zFill)

    orbH            := na
    orbL            := na
    drawn           := false
    stopped         := false
    startBar        := na
    sessionStartBar := na
    lnH             := na
    lnL             := na
    lbH             := na
    lbL             := na
    zFill           := na

    candleCover     := na
    candleEntry     := na
    orbBreakDir     := 0

    snFvgExt        := na
    snFvgHasExt     := false
    snFvgIsBull     := false

    fvgExtCover     := na
    fvgExtTP        := na

    pendingBox      := na
    pendingLabel    := na
    pendingExt      := na

    if array.size(fvgBoxes) > 0
        for i = 0 to array.size(fvgBoxes) - 1
            box.delete(array.get(fvgBoxes, i))
            label.delete(array.get(fvgLabels, i))
            if not na(array.get(fvgExtLines, i))
                line.delete(array.get(fvgExtLines, i))
    array.clear(fvgBoxes)
    array.clear(fvgLabels)
    array.clear(fvgTops)
    array.clear(fvgBots)
    array.clear(fvgIsBulls)
    array.clear(fvgExtLines)
    fvgWasActive := false


// ═════════════════════════════════════════════════════════════════════════════
//  ORB — Opening Range Breakout
// ═════════════════════════════════════════════════════════════════════════════

// ── STEP 0  —  Record the 9:30 bar_index ──────────────────────────────────
if nyH == 9 and nyM == 30 and na(sessionStartBar)
    sessionStartBar := bar_index

// ── STEP 1  —  Accumulate the ORB High / Low ──────────────────────────────
if inORBWindow and not drawn
    orbH := na(orbH) ? high : math.max(orbH, high)
    orbL := na(orbL) ? low  : math.min(orbL, low)

// ── STEP 2  —  Draw lines & labels ────────────────────────────────────────
if pastORB and not drawn and not na(orbH) and not na(orbL)
    drawn    := true
    startBar := not na(sessionStartBar) ? sessionStartBar : bar_index

    lnH := line.new(startBar, orbH, bar_index + 1, orbH,
         color=i_highColor, width=i_lWidth, style=f_ls(), extend=extend.right)
    lnL := line.new(startBar, orbL, bar_index + 1, orbL,
         color=i_lowColor,  width=i_lWidth, style=f_ls(), extend=extend.right)

    if i_showZone
        zFill := linefill.new(lnH, lnL, color.new(color.gray, i_zoneAlpha))

    if i_showLbl
        lbH := label.new(
             x         = startBar,
             y         = orbH,
             text      = i_lblHText,
             color     = chart.bg_color,
             textcolor = i_highColor,
             style     = f_vStyle(),
             size      = f_sz())
        lbL := label.new(
             x         = startBar,
             y         = orbL,
             text      = i_lblLText,
             color     = chart.bg_color,
             textcolor = i_lowColor,
             style     = f_vStyle(),
             size      = f_sz())

// ── STEP 3  —  Update label X positions every bar ─────────────────────────
if drawn and not stopped and i_showLbl
    if not na(lbH)
        label.set_x(lbH, f_lx(i_lblHPos, startBar, bar_index))
    if not na(lbL)
        label.set_x(lbL, f_lx(i_lblLPos, startBar, bar_index))


// ═════════════════════════════════════════════════════════════════════════════
//  FVG PENDING — Draw on bar open, confirm/adjust/delete on bar close
// ═════════════════════════════════════════════════════════════════════════════
if barstate.isnew and bar_index >= 2
    if inFVGWindow and not stopped[1]
        isBullOpen = high[2] < low
        isBearOpen = low[2] > high

        if isBullOpen or isBearOpen
            pendingTop := isBullOpen ? low : low[2]
            pendingBot := isBullOpen ? high[2] : high

            pendingBox := box.new(
                left         = bar_index[2],
                right        = bar_index[2] + i_fvgBoxLen,
                top          = pendingTop,
                bottom       = pendingBot,
                bgcolor      = isBullOpen ? i_fvgBullCol : i_fvgBearCol,
                border_color = isBullOpen ? i_fvgBullCol : i_fvgBearCol)

            pendingLabel := label.new(
                x         = bar_index[2] + math.max(1, i_fvgBoxLen - 3),
                y         = (pendingTop + pendingBot) / 2,
                text      = "FVG",
                color     = color.new(color.white, 100),
                style     = label.style_label_center,
                textcolor = isBullOpen ? color.green : color.red,
                size      = size.small,
                textalign = text.align_right)

            if i_extEnabled
                extLevel = isBullOpen ? low[1] : high[1]
                if extLevel < pendingBot or extLevel > pendingTop
                    pendingExt := line.new(
                        bar_index[1], extLevel,
                        bar_index[1] + i_extLen, extLevel,
                        color = isBullOpen ? i_fvgBullCol : i_fvgBearCol,
                        width = i_extWidth,
                        style = f_extStyle())


// ═════════════════════════════════════════════════════════════════════════════
//  FVG — Fair Value Gap (multi-track, ORB-break gated)
// ═════════════════════════════════════════════════════════════════════════════
if bar_index >= 2 and barstate.isconfirmed

    // ── Session tracking ─────────────────────────────────────────────────
    if inFVGWindow
        fvgWasActive := true

    // ── End-time cleanup: delete ALL remaining FVGs when session ends ─────
    if fvgWasActive and not inFVGWindow and array.size(fvgBoxes) > 0
        for i = 0 to array.size(fvgBoxes) - 1
            box.delete(array.get(fvgBoxes, i))
            label.delete(array.get(fvgLabels, i))
            if not na(array.get(fvgExtLines, i))
                line.delete(array.get(fvgExtLines, i))
        array.clear(fvgBoxes)
        array.clear(fvgLabels)
        array.clear(fvgTops)
        array.clear(fvgBots)
        array.clear(fvgIsBulls)
        array.clear(fvgExtLines)

    // ── Mitigation: remove individual FVGs whose gap zone is traded into ──
    if array.size(fvgBoxes) > 0
        i = array.size(fvgBoxes) - 1
        while i >= 0
            top  = array.get(fvgTops,    i)
            bot  = array.get(fvgBots,    i)
            bull = array.get(fvgIsBulls, i)

            mitigated = (bull and close < bot) or (not bull and close > top)

            if mitigated
                box.delete(array.get(fvgBoxes, i))
                label.delete(array.get(fvgLabels, i))
                if not na(array.get(fvgExtLines, i))
                    line.delete(array.get(fvgExtLines, i))
                array.remove(fvgBoxes,   i)
                array.remove(fvgLabels,  i)
                array.remove(fvgTops,    i)
                array.remove(fvgBots,    i)
                array.remove(fvgIsBulls, i)
                array.remove(fvgExtLines,i)
            i -= 1

    // ── Resolve pending FVG drawn on bar open ────────────────────────────
    if not na(pendingBox)
        isBullClose = high[2] < low
        isBearClose = low[2] > high

        if isBullClose or isBearClose
            finalTop = isBullClose ? low : low[2]
            finalBot = isBullClose ? high[2] : high

            box.set_top(pendingBox, finalTop)
            box.set_bottom(pendingBox, finalBot)
            box.set_bgcolor(pendingBox, isBullClose ? i_fvgBullCol : i_fvgBearCol)
            box.set_border_color(pendingBox, isBullClose ? i_fvgBullCol : i_fvgBearCol)
            label.set_y(pendingLabel, (finalTop + finalBot) / 2)
            label.set_textcolor(pendingLabel, isBullClose ? color.green : color.red)

            if not na(pendingExt)
                line.delete(pendingExt)
            line newExtLine = na
            if i_extEnabled
                extLevel = isBullClose ? low[1] : high[1]
                if extLevel < finalBot or extLevel > finalTop
                    newExtLine := line.new(
                        bar_index[1], extLevel,
                        bar_index[1] + i_extLen, extLevel,
                        color = isBullClose ? i_fvgBullCol : i_fvgBearCol,
                        width = i_extWidth,
                        style = f_extStyle())

            if array.size(fvgBoxes) >= i_maxFvgs
                box.delete(array.get(fvgBoxes, 0))
                label.delete(array.get(fvgLabels, 0))
                if not na(array.get(fvgExtLines, 0))
                    line.delete(array.get(fvgExtLines, 0))
                array.remove(fvgBoxes,    0)
                array.remove(fvgLabels,   0)
                array.remove(fvgTops,     0)
                array.remove(fvgBots,     0)
                array.remove(fvgIsBulls,  0)
                array.remove(fvgExtLines, 0)

            array.push(fvgBoxes,    pendingBox)
            array.push(fvgLabels,   pendingLabel)
            array.push(fvgTops,     finalTop)
            array.push(fvgBots,     finalBot)
            array.push(fvgIsBulls,  isBullClose)
            array.push(fvgExtLines, newExtLine)
        else
            box.delete(pendingBox)
            label.delete(pendingLabel)
            if not na(pendingExt)
                line.delete(pendingExt)

        pendingBox   := na
        pendingLabel := na
        pendingExt   := na
        pendingTop   := na
        pendingBot   := na

    // ── Detection: find new FVGs (historical bars or when no pending FVG) ─
    else if inFVGWindow and not stopped[1]

        isBull = high[2] < low
        isBear = low[2] > high

        if isBull or isBear

            // FIFO cap: remove oldest FVG if at the limit
            if array.size(fvgBoxes) >= i_maxFvgs
                box.delete(array.get(fvgBoxes, 0))
                label.delete(array.get(fvgLabels, 0))
                if not na(array.get(fvgExtLines, 0))
                    line.delete(array.get(fvgExtLines, 0))
                array.remove(fvgBoxes,    0)
                array.remove(fvgLabels,   0)
                array.remove(fvgTops,     0)
                array.remove(fvgBots,     0)
                array.remove(fvgIsBulls,  0)
                array.remove(fvgExtLines, 0)

            top = isBull ? low : low[2]
            bot = isBull ? high[2] : high

            newBox = box.new(
                left         = bar_index[2],
                right        = bar_index[2] + i_fvgBoxLen,
                top          = top,
                bottom       = bot,
                bgcolor      = isBull ? i_fvgBullCol : i_fvgBearCol,
                border_color = isBull ? i_fvgBullCol : i_fvgBearCol
            )

            newLabel = label.new(
                x         = bar_index[2] + math.max(1, i_fvgBoxLen - 3),
                y         = (top + bot) / 2,
                text      = "FVG",
                color     = color.new(color.white, 100),
                style     = label.style_label_center,
                textcolor = isBull ? color.green : color.red,
                size      = size.small,
                textalign = text.align_right
            )

            // FVG extension line: 2nd candle extreme outside the FVG gap
            line newExtLine = na
            if i_extEnabled
                extLevel = isBull ? low[1] : high[1]
                if extLevel < bot or extLevel > top
                    newExtLine := line.new(
                        bar_index[1],
                        extLevel,
                        bar_index[1] + i_extLen,
                        extLevel,
                        color = isBull ? i_fvgBullCol : i_fvgBearCol,
                        width = i_extWidth,
                        style = f_extStyle()
                    )

            array.push(fvgBoxes,    newBox)
            array.push(fvgLabels,   newLabel)
            array.push(fvgTops,     top)
            array.push(fvgBots,     bot)
            array.push(fvgIsBulls,  isBull)
            array.push(fvgExtLines, newExtLine)


// ═════════════════════════════════════════════════════════════════════════════
//  BREAKOUT + STRATEGY ENTRY
// ═════════════════════════════════════════════════════════════════════════════
// Only consume the ORB (set stopped, compute levels, enter) when the breakout
// happens during the allowed trade session AND a valid directional FVG with
// an extension line exists.  Breakouts outside the session are silently ignored.
// Breakouts inside the session with no qualifying FVG+ext also consume the day.

// ── Diagnostic shapes ──────────────────────────────────────────────────────
plotshape(drawn and not stopped and barstate.isconfirmed and close > orbH,
     title="Break Up", style=shape.triangleup, location=location.belowbar,
     color=color.green, size=size.small)
plotshape(drawn and not stopped and barstate.isconfirmed and close < orbL,
     title="Break Down", style=shape.triangledown, location=location.abovebar,
     color=color.red, size=size.small)
plotshape(drawn and not stopped and barstate.isconfirmed and inTradeSession,
     title="In Session", style=shape.circle, location=location.absolute,
     color=color.new(color.yellow, 80), size=size.tiny)

// ── Breakout detection ── session-qualified, FVG+ext-qualified ────────────
if drawn and not stopped and barstate.isconfirmed
    bool breakoutUp   = close > orbH
    bool breakoutDown = close < orbL

    if (breakoutUp or breakoutDown) and inTradeSession
        stopped := true

        // ── Determine breakout direction ──
        if breakoutUp
            orbBreakDir := 1
        else if breakoutDown
            orbBreakDir := -1

        // ── Candle Entry (always computed) ──
        candleEntry := close
        if orbBreakDir == 1
            candleCover := low - 0.25
        else
            candleCover := high + 0.25

        // ── FVG+ext qualification: find most recent active FVG matching
        //    direction that also has an extension line ──
        // For LONG: need a BULLISH FVG (fvgIsBull == true) with ext line
        // For SHORT: need a BEARISH FVG (fvgIsBull == false) with ext line
        // Scans from newest to oldest and picks the first match.
        int  fvgCount      = array.size(fvgBoxes)
        bool fvgQualified  = false
        float qualExtCover = na

        if fvgCount > 0
            for i = fvgCount - 1 to 0
                bool  isBull = array.get(fvgIsBulls, i)
                // Direction must match trade direction:
                // LONG needs bullish FVG, SHORT needs bearish FVG
                bool dirMatch = (orbBreakDir == 1 and isBull) or (orbBreakDir == -1 and not isBull)
                if dirMatch
                    line extLine = array.get(fvgExtLines, i)
                    if not na(extLine)
                        float extPrice = line.get_y1(extLine)
                        // Ext Cover: bullish → extPrice - 0.25, bearish → extPrice + 0.25
                        qualExtCover  := isBull ? extPrice - 0.25 : extPrice + 0.25
                        snFvgIsBull   := isBull
                        snFvgExt      := qualExtCover
                        snFvgHasExt   := true
                        fvgQualified  := true
                        break

        // ── Compute trade levels ──
        if fvgQualified
            fvgExtCover := qualExtCover

            // 2:1 Risk-to-Reward using Candle Entry and FVG Ext Cover as SL
            if orbBreakDir == 1
                fvgExtTP := candleEntry + 2 * (candleEntry - fvgExtCover)
            else
                fvgExtTP := candleEntry - 2 * (fvgExtCover - candleEntry)
        else
            // No qualifying FVG+ext — mark as no trade for this day
            snFvgExt      := na
            snFvgHasExt   := false
            fvgExtCover   := na
            fvgExtTP       := na

        // ── Freeze ORB lines at breakout bar ──
        line.set_extend(lnH, extend.none)
        line.set_extend(lnL, extend.none)
        line.set_x2    (lnH, bar_index)
        line.set_x2    (lnL, bar_index)

        if i_showLbl
            if not na(lbH)
                label.set_x(lbH, f_lx(i_lblHPos, startBar, bar_index))
            if not na(lbL)
                label.set_x(lbL, f_lx(i_lblLPos, startBar, bar_index))

        // ── Strategy entry + bracket exit (only if FVG+ext qualified) ──
        if fvgQualified
            // Position size based on fixed risk using FVG Ext Cover as SL distance
            float riskDistance    = math.abs(candleEntry - fvgExtCover)
            float riskDollars     = i_accountSize * i_riskPercent
            float pointVal        = na(syminfo.pointvalue) or syminfo.pointvalue == 0 ? 2.0 : syminfo.pointvalue
            float riskPerContract = riskDistance * pointVal
            int   contracts       = riskPerContract > 0 ? math.max(1, int(math.floor(riskDollars / riskPerContract))) : 1

            // ── Cap contracts by affordability (5 % margin) ──
            float notionalPerContract = close * pointVal
            float marginPerContract   = notionalPerContract * 0.05
            if marginPerContract > 0
                int maxAffordable = int(math.floor(strategy.equity / marginPerContract))
                contracts := math.min(contracts, math.max(1, maxAffordable))

            if orbBreakDir == 1
                strategy.entry("Long", strategy.long, qty=contracts)
                strategy.exit("ExitLong", "Long", limit=fvgExtTP, stop=fvgExtCover)
            else if orbBreakDir == -1
                strategy.entry("Short", strategy.short, qty=contracts)
                strategy.exit("ExitShort", "Short", limit=fvgExtTP, stop=fvgExtCover)

// ── Debug diagnostics ──────────────────────────────────────────────────────
plotchar(drawn,           "debug_drawn",   "D", location.top,    color.new(color.green,  0), size=size.tiny)
plotchar(stopped,          "debug_stopped", "S", location.top,    color.new(color.red,    0), size=size.tiny)
plotchar(inTradeSession,   "debug_session", "T", location.bottom, color.new(color.yellow, 0), size=size.tiny)